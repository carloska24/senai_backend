<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Exercicio01"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value="Classificação por Idade"/>
        <attribute name="saved" value="2026-08-08 02:28:00 PM"/>
        <attribute name="created" value="2026-08-08 02:28:00 PM"/>
        <attribute name="edited" value="2026-08-08 02:28:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="idade" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite a sua idade:&quot;" newline="True"/>
            <input variable="idade"/>
            <if expression="idade &lt; 12">
                <then>
                    <output expression="&quot;Criança&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="idade &lt;= 17">
                        <then>
                            <output expression="&quot;Adolescente&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Adulta&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
