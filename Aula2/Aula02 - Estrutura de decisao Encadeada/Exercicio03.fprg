<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Exercicio03"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value="Classificação de Desempenho Escolar por Nota"/>
        <attribute name="saved" value="2026-08-08 03:20:00 PM"/>
        <attribute name="created" value="2026-08-08 03:20:00 PM"/>
        <attribute name="edited" value="2026-08-08 03:20:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nota" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a nota do aluno:&quot;" newline="True"/>
            <input variable="nota"/>
            <if expression="nota &gt;= 9">
                <then>
                    <output expression="&quot;Excelente&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="nota &gt;= 7">
                        <then>
                            <output expression="&quot;Bom&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="nota &gt;= 6">
                                <then>
                                    <output expression="&quot;Regular&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Reprovado&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
