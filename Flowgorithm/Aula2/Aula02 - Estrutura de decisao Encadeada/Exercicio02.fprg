<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Exercicio01"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value="Classificação de Temperatura"/>
        <attribute name="saved" value="2026-08-08 02:17:00 PM"/>
        <attribute name="created" value="2026-08-08 02:17:00 PM"/>
        <attribute name="edited" value="2026-08-08 02:17:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="temperatura" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a temperatura em graus Celsius:&quot;" newline="True"/>
            <input variable="temperatura"/>
            <if expression="temperatura &gt; 30">
                <then>
                    <output expression="&quot;Está quente&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="temperatura &gt;= 20">
                        <then>
                            <output expression="&quot;O clima está agradável&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Está frio&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
