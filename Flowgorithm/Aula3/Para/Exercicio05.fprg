<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercicio05"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value="Gera uma sequência personalizada entre dois números informados pelo usuário."/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="inicio, fim, i" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite o número de início:&quot;" newline="True"/>
            <input variable="inicio"/>
            <output expression="&quot;Digite o número de fim:&quot;" newline="True"/>
            <input variable="fim"/>
            <if expression="inicio &lt;= fim">
                <then>
                    <for variable="i" start="inicio" end="fim" direction="inc" step="1">
                        <output expression="i" newline="True"/>
                    </for>
                </then>
                <else>
                    <for variable="i" start="inicio" end="fim" direction="dec" step="1">
                        <output expression="i" newline="True"/>
                    </for>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
