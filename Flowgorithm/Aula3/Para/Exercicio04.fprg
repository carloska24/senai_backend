<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercicio04"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value="Tabuada de um número fornecido pelo usuário."/>
        <attribute name="saved" value="2026-08-15 12:25:00 "/>
        <attribute name="created" value="2026-08-15 12:25:00 "/>
        <attribute name="edited" value="2026-08-15 12:25:00 "/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, i" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um número para ver a sua tabuada:&quot;" newline="True"/>
            <input variable="numero"/>
            <for variable="i" start="1" end="10" direction="inc" step="1">
                <output expression="numero &amp; &quot; x &quot; &amp; i &amp; &quot; = &quot; &amp; (numero * i)" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
