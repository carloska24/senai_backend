<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercicio01"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value="Leitura de 10 numeros inteiros em um vetor e exibicao na ordem inversa."/>
        <attribute name="saved" value="2026-08-21 23:12:00 "/>
        <attribute name="created" value="2026-08-21 23:12:00 "/>
        <attribute name="edited" value="2026-08-21 23:12:00 "/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numeros" type="Integer" array="True" size="10"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <output expression="&quot;Digite o numero para a posicao &quot; &amp; (i + 1) &amp; &quot;:&quot;" newline="True"/>
                <input variable="numeros[i]"/>
            </for>
            <output expression="&quot;Numeros na ordem inversa:&quot;" newline="True"/>
            <for variable="i" start="9" end="0" direction="dec" step="1">
                <output expression="numeros[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
