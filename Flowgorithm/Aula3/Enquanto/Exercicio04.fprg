<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercicio04"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value="Validação de nota entre 0 e 10 utilizando a estrutura ENQUANTO."/>
        <attribute name="saved" value="2026-08-15 12:25:00 "/>
        <attribute name="created" value="2026-08-15 12:25:00 "/>
        <attribute name="edited" value="2026-08-15 12:25:00 "/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="notaAluno" type="Real" array="False" size=""/>
            <output expression="&quot;Digite uma nota entre 0 e 10:&quot;" newline="True"/>
            <input variable="notaAluno"/>
            <while expression="notaAluno &lt; 0 || notaAluno &gt; 10">
                <output expression="&quot;Nota inválida! A nota deve estar entre 0 e 10. Digite novamente:&quot;" newline="True"/>
                <input variable="notaAluno"/>
            </while>
            <output expression="&quot;Nota válida registrada com sucesso:&quot;" newline="True"/>
            <output expression="notaAluno" newline="True"/>
        </body>
    </function>
</flowgorithm>
