<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ExercicioDesafio"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value="Soma separadamente os números pares e ímpares de 1 até 100 usando ENQUANTO."/>
        <attribute name="saved" value="2026-08-15 11:24:00 "/>
        <attribute name="created" value="2026-08-15 11:24:00 "/>
        <attribute name="edited" value="2026-08-15 11:24:00 "/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="contador" type="Integer" array="False" size=""/>
            <declare name="somaPares" type="Integer" array="False" size=""/>
            <declare name="somaImpares" type="Integer" array="False" size=""/>
            <assign variable="somaPares" expression="0"/>
            <assign variable="somaImpares" expression="0"/>
            <assign variable="contador" expression="1"/>
            <while expression="contador &lt;= 100">
                <if expression="contador % 2 == 0">
                    <then>
                        <assign variable="somaPares" expression="somaPares + contador"/>
                    </then>
                    <else>
                        <assign variable="somaImpares" expression="somaImpares + contador"/>
                    </else>
                </if>
                <assign variable="contador" expression="contador + 1"/>
            </while>
            <output expression="&quot;Soma de todos os números pares entre 1 e 100:&quot;" newline="True"/>
            <output expression="somaPares" newline="True"/>
            <output expression="&quot;Soma de todos os números ímpares entre 1 e 100:&quot;" newline="True"/>
            <output expression="somaImpares" newline="True"/>
        </body>
    </function>
</flowgorithm>
