    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="idade" type="Integer" array="False" size=""/>
            <declare name="calculaIdade" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite sua idade&quot;" newline="True"/>
            <input variable="idade"/>
            <assign variable="calculaIdade" expression="idade * 365"/>
            <output expression="&quot;voce tem &quot; &amp; calculaIdade &amp; &quot; dias de vida!&quot;" newline="True"/>
        </body>
    </function>
