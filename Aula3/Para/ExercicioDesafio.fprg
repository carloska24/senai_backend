<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ExercicioDesafio"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value="Calcula o fatorial de um número com tratamento de erros solicitando novo valor para negativos e 0 (Desafio)."/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, i, fatorial" type="Integer" array="False" size=""/>
            <declare name="valido" type="Boolean" array="False" size=""/>
            <assign variable="valido" expression="False"/>
            <while expression="!valido">
                <output expression="&quot;Digite um número para calcular o fatorial:&quot;" newline="True"/>
                <input variable="numero"/>
                <if expression="numero &lt; 0">
                    <then>
                        <output expression="&quot;Número negativo (não existe fatorial). Insira novamente.&quot;" newline="True"/>
                    </then>
                    <else>
                        <if expression="numero == 0">
                            <then>
                                <output expression="&quot;Fatorial de 0 é 1 (0! = 1). Insira um novo valor para calcular.&quot;" newline="True"/>
                            </then>
                            <else>
                                <assign variable="valido" expression="True"/>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
            
            <assign variable="fatorial" expression="1"/>
            <for variable="i" start="1" end="numero" direction="inc" step="1">
                <assign variable="fatorial" expression="fatorial * i"/>
            </for>
            <output expression="numero &amp; &quot;! = &quot; &amp; fatorial" newline="True"/>
        </body>
    </function>
</flowgorithm>
