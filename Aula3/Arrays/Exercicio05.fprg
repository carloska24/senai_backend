<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercicio05"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value="Armazena 10 numeros inteiros em vetor e conta a quantidade de numeros pares e impares."/>
        <attribute name="saved" value="2026-08-21 23:12:00 "/>
        <attribute name="created" value="2026-08-21 23:12:00 "/>
        <attribute name="edited" value="2026-08-21 23:12:00 "/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numeros" type="Integer" array="True" size="10"/>
            <declare name="qtdPares" type="Integer" array="False" size=""/>
            <declare name="qtdImpares" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="qtdPares" expression="0"/>
            <assign variable="qtdImpares" expression="0"/>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <output expression="&quot;Digite o numero &quot; &amp; (i + 1) &amp; &quot;:&quot;" newline="True"/>
                <input variable="numeros[i]"/>
                <if expression="numeros[i] % 2 == 0">
                    <then>
                        <assign variable="qtdPares" expression="qtdPares + 1"/>
                    </then>
                    <else>
                        <assign variable="qtdImpares" expression="qtdImpares + 1"/>
                    </else>
                </if>
            </for>
            <output expression="&quot;Total de numeros pares:&quot;" newline="True"/>
            <output expression="qtdPares" newline="True"/>
            <output expression="&quot;Total de numeros impares:&quot;" newline="True"/>
            <output expression="qtdImpares" newline="True"/>
        </body>
    </function>
</flowgorithm>
