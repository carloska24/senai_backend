    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="grausCelsius" type="Real" array="False" size=""/>
            <declare name="fahrenheit" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a temperatura em graus celsius&quot;" newline="True"/>
            <input variable="grausCelsius"/>
            <assign variable="fahrenheit" expression="grausCelsius * (9/5) + 32"/>
            <output expression="&quot;A temperatura em Fahrenheit &#233; :&quot; &amp; fahrenheit" newline="True"/>
        </body>
    </function>
</flowgorithm>
