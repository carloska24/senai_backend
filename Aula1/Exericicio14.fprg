    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="letra" type="String" array="False" size=""/>
            <declare name="vogal" type="Boolean" array="False" size=""/>
            <output expression="&quot; digite uma letra &quot;" newline="True"/>
            <input variable="letra"/>
            <assign variable="vogal" expression="letra = a || letra = A || letra = e || letra = E || letra = i || letra = I || letra = o || letra = O || letra =u || letra = U"/>
            <if expression="vogal">
                <then>
                    <output expression="&quot; A letra digitada &#233; uma vogal! &quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot; A letra digitada &#233; uma consoante ! &quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
